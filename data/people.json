  "pastTnChiefMinisters": [
    {
      "name": "K. Kamaraj", "nameTa": "கே. காமராஜ்", "years": "1954–1963",
      "workEn": ["Opened thousands of schools in villages and promoted the midday meal in schools.", "Pushed irrigation dams and industrial growth across the state."],
      "workTa": ["கிராமங்களில் ஆயிரக்கணக்கான பள்ளிகளைத் திறந்து, பள்ளிகளில் மதிய உணவுத் திட்டத்தை முன்னெடுத்தார்.", "நீர்ப்பாசன அணைகள், தொழில் வளர்ச்சியை மாநிலம் முழுவதும் ஊக்குவித்தார்."],
      "search": "K. Kamaraj"
    },
    {
      "name": "C. N. Annadurai", "nameTa": "சி. என். அண்ணாதுரை", "years": "1967–1969",
      "workEn": ["Madras State was officially renamed Tamil Nadu (1969).", "Established the two-language (Tamil and English) policy in schools."],
      "workTa": ["மதராஸ் மாநிலம் அதிகாரப்பூர்வமாக 'தமிழ்நாடு' என்று பெயர் மாற்றப்பட்டது (1969).", "பள்ளிகளில் தமிழ் – ஆங்கிலம் இருமொழிக் கொள்கையை உறுதி செய்தார்."],
      "search": "C. N. Annadurai"
    },
    {
      "name": "M. G. Ramachandran", "nameTa": "எம். ஜி. ராமச்சந்திரன்", "years": "1977–1987",
      "workEn": ["Expanded the noon meal scheme into the Nutritious Meal Programme for school children (1982)."],
      "workTa": ["பள்ளிக் குழந்தைகளுக்கான சத்துணவுத் திட்டத்தை விரிவுபடுத்தினார் (1982)."],
      "search": "M. G. Ramachandran"
    },
    {
      "name": "M. Karunanidhi", "nameTa": "மு. கருணாநிதி", "years": "1969–1976, 1989–1991, 1996–2001, 2006–2011 (five terms)",
      "workEn": ["Started the Uzhavar Sandhai farmers' markets (1999).", "Introduced the Samathuvapuram model villages for communal harmony."],
      "workTa": ["உழவர் சந்தைகளைத் தொடங்கினார் (1999).", "சமத்துவபுரம் எனும் சமூக நல்லிணக்கக் குடியிருப்புகளை உருவாக்கினார்."],
      "search": "M. Karunanidhi"
    },
    {
